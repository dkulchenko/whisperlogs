<Layouts.app flash={@flash} current_scope={@current_scope}>
  <main
    id="oauth-consent"
    class="mx-auto flex min-h-[70vh] w-full max-w-2xl items-center px-4 py-10"
  >
    <section class="w-full overflow-hidden rounded-3xl border border-slate-200 bg-white shadow-xl shadow-slate-950/5 dark:border-slate-800 dark:bg-slate-950">
      <div class="border-b border-slate-200 bg-gradient-to-br from-indigo-50 via-white to-cyan-50 px-6 py-7 dark:border-slate-800 dark:from-indigo-950/50 dark:via-slate-950 dark:to-cyan-950/30 sm:px-8">
        <div class="mb-5 flex size-12 items-center justify-center rounded-2xl bg-indigo-600 text-white shadow-lg shadow-indigo-600/20">
          <.icon name="hero-magnifying-glass" class="size-6" />
        </div>
        <p class="text-sm font-semibold uppercase tracking-[0.18em] text-indigo-600 dark:text-indigo-300">
          Connect to WhisperLogs
        </p>
        <h1 class="mt-2 text-2xl font-semibold tracking-tight text-slate-950 dark:text-white sm:text-3xl">
          Allow {@client.client_name} to search logs?
        </h1>
      </div>

      <div class="space-y-6 px-6 py-7 sm:px-8">
        <div class="rounded-2xl border border-slate-200 bg-slate-50 p-4 dark:border-slate-800 dark:bg-slate-900/60">
          <div class="flex gap-3">
            <div class="mt-0.5 flex size-9 shrink-0 items-center justify-center rounded-xl bg-emerald-100 text-emerald-700 dark:bg-emerald-950 dark:text-emerald-300">
              <.icon name="hero-check" class="size-5" />
            </div>
            <div>
              <p class="font-medium text-slate-950 dark:text-white">
                Read and search workspace logs
              </p>
              <p class="mt-1 text-sm leading-6 text-slate-600 dark:text-slate-300">
                This connection is read-only. It cannot ingest, edit, export, or delete logs.
              </p>
            </div>
          </div>
        </div>

        <dl class="grid gap-3 text-sm sm:grid-cols-2">
          <div class="rounded-xl border border-slate-200 px-4 py-3 dark:border-slate-800">
            <dt class="text-slate-500 dark:text-slate-400">Signed in as</dt>
            <dd class="mt-1 truncate font-medium text-slate-900 dark:text-white">
              {@current_scope.user.email}
            </dd>
          </div>
          <div class="rounded-xl border border-slate-200 px-4 py-3 dark:border-slate-800">
            <dt class="text-slate-500 dark:text-slate-400">Returns to</dt>
            <dd class="mt-1 truncate font-medium text-slate-900 dark:text-white">
              {URI.parse(@client.redirect_uri).host}
            </dd>
          </div>
        </dl>

        <.form for={@form} id="oauth-consent-form" action={~p"/oauth/authorize"} method="post">
          <input type="hidden" name="authorization_request" value={@authorization_request} />
          <div class="flex flex-col-reverse gap-3 sm:flex-row sm:justify-end">
            <button
              id="oauth-deny-button"
              type="submit"
              name="decision"
              value="deny"
              class="rounded-xl border border-slate-300 px-5 py-3 text-sm font-semibold text-slate-700 transition hover:-translate-y-0.5 hover:bg-slate-50 dark:border-slate-700 dark:text-slate-200 dark:hover:bg-slate-900"
            >
              Cancel
            </button>
            <button
              id="oauth-allow-button"
              type="submit"
              name="decision"
              value="allow"
              class="rounded-xl bg-indigo-600 px-5 py-3 text-sm font-semibold text-white shadow-lg shadow-indigo-600/20 transition hover:-translate-y-0.5 hover:bg-indigo-500 active:translate-y-0"
            >
              Allow log search
            </button>
          </div>
        </.form>
      </div>
    </section>
  </main>
</Layouts.app>
