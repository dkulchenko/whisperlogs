<Layouts.app flash={@flash} current_scope={@current_scope}>
  <main
    id="oauth-invalid-request"
    class="mx-auto flex min-h-[60vh] max-w-xl items-center px-4 py-10"
  >
    <section class="w-full rounded-3xl border border-rose-200 bg-white p-8 text-center shadow-xl shadow-rose-950/5 dark:border-rose-900 dark:bg-slate-950">
      <div class="mx-auto flex size-12 items-center justify-center rounded-2xl bg-rose-100 text-rose-700 dark:bg-rose-950 dark:text-rose-300">
        <.icon name="hero-exclamation-triangle" class="size-6" />
      </div>
      <h1 class="mt-5 text-2xl font-semibold text-slate-950 dark:text-white">
        Connection request rejected
      </h1>
      <p class="mt-3 text-sm leading-6 text-slate-600 dark:text-slate-300">
        The OAuth request was invalid or expired. Return to your MCP client and start the connection again.
      </p>
    </section>
  </main>
</Layouts.app>
